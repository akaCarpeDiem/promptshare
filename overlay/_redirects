# Every page is a real HTML file written by scripts/build-site.mjs. Plates (/p/:id) are served by
# functions/p/[id].ts; the rewrite below is only the fallback if that function is unavailable.
/p/* /index.html 200
# Legacy /c/:id plate URLs are 301'd by functions/c/[id].ts — do not rewrite them here.

